DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

# Redirect www to the bare domain (301) so Google sees one canonical host; other subdomains (oyen) are unaffected
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.moclittlefarm\.com$ [NC]
RewriteRule ^(.*)$ https://moclittlefarm.com/$1 [R=301,L]
